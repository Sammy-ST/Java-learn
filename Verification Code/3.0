import java.util.Scanner;

//import java.util.Random;
public class YanZhengMa2 {

    public static void main (String[] args){
        Scanner sc=new Scanner(System.in);

        while(true) {
            int c = table(sc);
            if (c == 1) {
                getCode(sc);
            } else if (c == 2) {
                break;
            }else{
                System.out.println("请输入正确的数字：");
                System.out.println(" ");
            }
        }

    }

    public static int table(Scanner sc){
        System.out.println("===验证码生成器===");
        System.out.println("1.生成验证码。");
        System.out.println("2.退出。");
        System.out.print("请输入选择：");

        int choice=sc.nextInt();
        return choice;
    }
    public static void getCode(Scanner sc){
        //String code="";
        System.out.println("请输入验证码位数：");
        int n=sc.nextInt();
        StringBuilder code=new StringBuilder();

        for(int i=0;i<n;i++){
            int type=(int)(Math.random()*3);
            switch(type){
                case 0:
                    // append() 方法直接把字符追加到底层数组里，不创建新对象

                    code.append((int) (Math.random() * 10));
                    break;
                case 1:
                    code.append((char) (Math.random() * 26 + 'a'));
                    break;
                case 2:
                    code.append((char) (Math.random() * 26 + 'A'));
                    break;
            }
        }
        System.out.println(code);
        System.out.println(" ");
    }
}
