import java.util.Scanner;
import java.util.Random;
public class GuessNumber2 {

    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);

        while(true){
            table();
            int choose=sc.nextInt();
            if(choose==2){
                end();
                break;
            }else if(choose==1){
                Random rd=new Random();
                int target=rd.nextInt(100)+1;
                judge(target,sc);
            }else{
                System.out.println("error!please put in correct number!");
            }
        }

    }
    public static void table(){
        System.out.println("===Start Game===");
        System.out.println("-----Table-----");
        System.out.println("1.start");
        System.out.println("2.exit");
    }

    public static void end(){
        System.out.println(" ");
        System.out.println("===You choose exit===");
        System.out.println("Bye Guys~");
    }

    public static void judge(int target,Scanner sc){//要加Scanner，不然在不同结构内，不能用Scanner
        int cnt=0;
        int max=100;
        int min=1;
        while(true){
            int a=sc.nextInt();
            cnt++;//简化

            if(a==target){
                //cnt++;
                System.out.println("congratulation!all you guess were"+cnt+"time!");
                break;
            }else if(a>target){
                max=a;
                //cnt++;
                System.out.println("too big.the range from" + min + " to " + max);
            }else if(a<target){
                min=a;
                //cnt++;
                System.out.println("too small.the range from" + min + " to " + max);
            }
        }

    }
}
